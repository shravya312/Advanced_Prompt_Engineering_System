QDRANT_URL=https://your-cluster.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
# Optional:
# PROMPT_VARIANT_LIMIT=3
# (default 1 = one API call per task; use 3 to compare ROUGE across prompt variants)
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash
# GEMINI_QA_MODEL=gemini-3.5-flash
# GEMINI_EXTRACTION_MODEL=gemini-3.5-flash
